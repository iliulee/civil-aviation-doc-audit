 {
  "file": "2026-06-15-MH-T 5040-2019 时钟系统检测规范.md",
  "line": 263,
  "num": "3.0.1",
  "kind": "clause",
  "text": "检测单位应以系统设计文件和施工合同为依据，确定检测范围，制定检测方案，编制检"
 },
 {
  "file": "2026-06-15-MH-T 5040-2019 时钟系统检测规范.md",
  "line": 265,
  "num": "3.0.2",
  "kind": "clause",
  "text": "检测范围一般应包括: 时标接收单元、监控单元(监控设备及监控软件)、母钟、信号"
 },
 {
  "file": "2026-06-15-MH-T 5040-2019 时钟系统检测规范.md",
  "line": 267,
  "num": "3.0.3",
  "kind": "clause",
  "text": "检测内容一般应包括: 设备安装检查、设备功能检测、接口功能检测和系统管理功能"
 },
 {
  "file": "2026-06-15-MH-T 5040-2019 时钟系统检测规范.md",
  "line": 269,
  "num": "3.0.4",
  "kind": "clause",
  "text": "检测工具应通过国家、地方或行业相关计量校准机构校准，校准合格且处于有效期；本"
 },
 {
  "file": "2026-06-15-MH-T 5040-2019 时钟系统检测规范.md",
  "line": 271,
  "num": "3.0.5",
  "kind": "clause",
  "text": "检测工作宜在基础设施完备、系统工程安装调试完成、与其他系统联调完成、施工工程"
 },
 {
