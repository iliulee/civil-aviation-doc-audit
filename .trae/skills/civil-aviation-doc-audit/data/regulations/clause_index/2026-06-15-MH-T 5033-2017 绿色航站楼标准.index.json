  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 1013,
  "num": "10.3.2",
  "kind": "clause",
  "text": "导向系统及导向标识应符合«公共信息导向系统设置原则与要求»"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 1016,
  "num": "10.3.3",
  "kind": "clause",
  "text": "航显系统应符合«民用运输机场航班信息显示系统工程设计规范» (MH/ T5015) 的规"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 1018,
  "num": "10.4",
  "kind": "section",
  "text": "无障碍设施"
 },
