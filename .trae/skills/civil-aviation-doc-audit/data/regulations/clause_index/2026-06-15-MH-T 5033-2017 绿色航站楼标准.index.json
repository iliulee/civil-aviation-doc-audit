  "line": 982,
  "num": "10.2.1",
  "kind": "clause",
  "text": "在航站楼旅客进出港流程中，应合理设置自助服务设备，提高旅客流程效率；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 983,
  "num": "10.2.2",
  "kind": "clause",
  "text": "自助值机设备设置应符合表10.2.2的规定；"
 },
