  "num": "10.5.4",
  "kind": "clause",
  "text": "特殊旅客卫生间配置应符合«城市公共厕所设计标准» (CJJ14) 和«民用机场旅客航"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 1075,
  "num": "10.6",
  "kind": "section",
  "text": "旅客其他服务设施"
 },
