  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 1109,
  "num": "10.6.7",
  "kind": "clause",
  "text": "宜针对不同群体旅客的差异化需求，提供多样化、个性化的文化娱乐休闲设施与互动"
 },
