 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 249,
  "num": "1.0.1",
  "kind": "clause",
  "text": "为规范机场航站楼绿色建设和运行，节约资源、保护环境，促进机场可持续发展，制定"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 251,
  "num": "1.0.2",
  "kind": "clause",
  "text": "本标准适用于航站楼新建、改(扩) 建、既有航站楼设施设备系统改造，以及航站楼运"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 255,
  "num": "1.0.3",
  "kind": "clause",
  "text": "绿色航站楼建设应结合航站楼所在地域的气候、环境、资源、经济及文化等特点，遵循"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 258,
  "num": "1.0.4",
  "kind": "clause",
  "text": "绿色航站楼运行应结合航站楼功能、流程和运行特点，遵循高效、低耗、人性化的原"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 260,
  "num": "1.0.5",
  "kind": "clause",
  "text": "绿色航站楼建设与运行，除应满足本标准的规定外，尚应符合国家、行业现行有关标准"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 270,
  "num": "2.0.1",
  "kind": "clause",
  "text": "航站楼terminal"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 272,
  "num": "2.0.2",
  "kind": "clause",
  "text": "绿色航站楼greenterminal"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 275,
  "num": "2.0.3",
  "kind": "clause",
  "text": "航站楼构型terminalconfiguration"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 278,
  "num": "2.0.4",
  "kind": "clause",
  "text": "航站楼分区terminalzoning"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 281,
  "num": "2.0.5",
  "kind": "clause",
  "text": "导向系统guidancesystem"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 290,
  "num": "3.0.1",
  "kind": "clause",
  "text": "航站楼规划设计应符合机场总体规划的要求，航站楼位置、构型、规模和建筑高度等应"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 292,
  "num": "3.0.2",
  "kind": "clause",
  "text": "航站楼建设方案应按照功能优先的原则，基于功能流程、节约环保、工程造价、运行效"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 296,
  "num": "3.0.3",
  "kind": "clause",
  "text": "航站楼设计应从节地、节能、节水、节材、室内外环境、人性化服务设施以及构型等方"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 303,
  "num": "3.0.4",
  "kind": "clause",
  "text": "航站楼施工应遵循国家和行业有关绿色施工的规定，实现施工过程的低资源消耗和低环"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 307,
  "num": "3.0.5",
  "kind": "clause",
  "text": "航站楼运行应通过对运行数据的跟踪分析，有针对性地开展能源、环境、流程、服务等"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 319,
  "num": "4.1",
  "kind": "section",
  "text": "一般规定"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 320,
  "num": "4.1.1",
  "kind": "clause",
  "text": "航站楼构型应以功能为先、效率为要、兼顾造型ꎻ建筑形式应简洁美观ꎻ旅客流程应合"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 322,
  "num": "4.1.2",
  "kind": "clause",
  "text": "航站楼应结合空、陆侧的相关配套功能进行统筹规划，充分利用航站楼的室内外空间，"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 328,
  "num": "4.1.3",
  "kind": "clause",
  "text": "应因地制宜、合理确定航站楼各层标高，满足空、陆侧衔接和室内空间需求；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 333,
  "num": "4.1.4",
  "kind": "clause",
  "text": "航站楼的建设应以“一次规划设计、分步具体实施” 为原则，充分考虑近、远期的合理"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 335,
  "num": "4.1.5",
  "kind": "clause",
  "text": "航站楼的改(扩) 建应合理利用现有资源，并对方案的技术、经济合理性等进行综合分"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 340,
  "num": "4.2",
  "kind": "section",
  "text": "构型"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 341,
  "num": "4.2.1",
  "kind": "clause",
  "text": "航站楼的构型应从飞机运行效率、近机位数量、旅客步行距离、分期开发、建设成本等"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 348,
  "num": "4.2.2",
  "kind": "clause",
  "text": "应合理控制航站楼体形系数，严寒、寒冷地区的航站楼体形系数不应大于0.2；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 351,
  "num": "4.2.3",
  "kind": "clause",
  "text": "旅客主要流线不应在短距离内出现多次转弯，且转弯角度不宜大于90°；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 355,
  "num": "4.2.4",
  "kind": "clause",
  "text": "旅客流程应简洁顺畅、导向清晰，减少旅客流线距离和楼层转换；旅客出港流线的最远"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 381,
  "num": "4.2.5",
  "kind": "clause",
  "text": "应合理控制航站楼的建筑高度和室内空间高度，主楼和指廊室内的大空间平均净高宜符"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 409,
  "num": "4.2.6",
  "kind": "clause",
  "text": "航站楼宜根据地域气候特征和功能需求在适宜区域设置半室外空间；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 413,
  "num": "4.2.7",
  "kind": "clause",
  "text": "登机桥固定桥的坡度应不大于1∶10；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 423,
  "num": "5.1",
  "kind": "section",
  "text": "一般规定"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 424,
  "num": "5.1.1",
  "kind": "clause",
  "text": "应在机场业务量预测基础上合理确定航站楼规模，优化航站楼建筑构型，提高空陆侧运"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 426,
  "num": "5.1.2",
  "kind": "clause",
  "text": "应根据飞机地面运行、地面服务设施布局的需要，合理进行航站楼站坪规划，节约"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 428,
  "num": "5.1.3",
  "kind": "clause",
  "text": "应合理配置地面服务设施，优化空陆侧运行流程，提高场区绿化率，提升航站楼周边环"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 430,
  "num": "5.1.4",
  "kind": "clause",
  "text": "应按照公共交通优先、人车分流的原则，合理布置陆侧交通设施，公共交通应靠近航站"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 432,
  "num": "5.1.5",
  "kind": "clause",
  "text": "应优化旅客陆侧交通组织，满足旅客采用多种交通方式进出机场的需求，减少旅客换乘"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 438,
  "num": "5.2",
  "kind": "section",
  "text": "土地利用"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 439,
  "num": "5.2.1",
  "kind": "clause",
  "text": "应在满足«民用机场总体规划规范» (MH/ T5002)、«民用机场工程项目建设标准» (建"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 443,
  "num": "5.2.2",
  "kind": "clause",
  "text": "应根据航站楼的建筑规模和使用需求，在符合表5.2.2的规定的基础上，合理确定航站"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 480,
  "num": "5.3",
  "kind": "section",
  "text": "室外环境"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 481,
  "num": "5.3.1",
  "kind": "clause",
  "text": "航站楼建筑外立面、屋面不宜采用镜面玻璃或抛光金属板等易产生眩光干扰的材料；采"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 483,
  "num": "5.3.2",
  "kind": "clause",
  "text": "航站楼泛光及景观照明应符合«民用机场飞行区技术标准»"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 486,
  "num": "5.3.3",
  "kind": "clause",
  "text": "航站楼空侧应合理规划机位、地面服务设施和清洁能源设施设备布局，并预留远期建设"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 488,
  "num": "5.3.4",
  "kind": "clause",
  "text": "针对机场所在区域的气候条件，宜对构型复杂的航站楼周边风环境进行模拟分析，优化"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 490,
  "num": "5.3.5",
  "kind": "clause",
  "text": "绿化景观建设应因地制宜，提供适宜的室外环境，降低热岛效应；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 491,
  "num": "5.4",
  "kind": "section",
  "text": "陆侧交通组织"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 492,
  "num": "5.4.1",
  "kind": "clause",
  "text": "应根据机场所在城市的绿色建设要求，结合机场建设定位、规模、使用特点和周边基础"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 503,
  "num": "5.4.2",
  "kind": "clause",
  "text": "应根据各种类型车辆进出机场的交通特征分析，合理进行陆侧交通道路设计，提高车辆"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 505,
  "num": "5.4.3",
  "kind": "clause",
  "text": "应合理规划楼前出租车、大巴车的蓄车和调度区域，提高出租车和大巴运行效率；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 506,
  "num": "5.4.4",
  "kind": "clause",
  "text": "应按照机动车与非机动车分流的原则，在航站楼附近适当位置设置非机动车存放区，并"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 510,
  "num": "5.4.5",
  "kind": "clause",
  "text": "大型机场应根据机动车停放需求，合理布局长期、短期停车区域；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 514,
  "num": "5.4.6",
  "kind": "clause",
  "text": "公共交通站点到达最近的航站楼出入口的步行距离宜不大于200m，超过300m时应设"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 519,
  "num": "5.4.7",
  "kind": "clause",
  "text": "应根据陆侧交通设施布局与清洁能源车发展预测，合理设置清洁能源车辆配套设施；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 520,
  "num": "5.4.8",
  "kind": "clause",
  "text": "陆侧交通导向系统应满足连续和准确引导的要求；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 521,
  "num": "5.4.9",
  "kind": "clause",
  "text": "航站楼与停车楼(场) 之间宜设置连接通道，实现人车分流，并根据机场所在地的气候"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 532,
  "num": "6.1",
  "kind": "section",
  "text": "一般规定"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 533,
  "num": "6.1.1",
  "kind": "clause",
  "text": "应对冷热源及其输配系统、照明系统及动力系统等能耗进行分项计量，宜配备智能化、"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 539,
  "num": "6.1.2",
  "kind": "clause",
  "text": "应满足«民用机场航站楼能效评价指南»"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 545,
  "num": "6.1.3",
  "kind": "clause",
  "text": "建筑供暖、空调、生活热水、供电等用能系统宜根据当地气候和自然资源条件，合理利"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 550,
  "num": "6.2",
  "kind": "section",
  "text": "建筑与围护结构"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 551,
  "num": "6.2.1",
  "kind": "clause",
  "text": "严寒和寒冷地区航站楼旅客出入口应根据当地冬季主导风向等实际情况设置门斗；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 554,
  "num": "6.2.2",
  "kind": "clause",
  "text": "在保证运行安全和室内空气品质的前提下，航站楼内条件允许的区域在过渡季宜采用自"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 567,
  "num": "6.2.3",
  "kind": "clause",
  "text": "航站楼围护结构的热工性能指标宜优于«公共建筑节能设计标准» (GB50189) 规定的"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 572,
  "num": "6.3",
  "kind": "section",
  "text": "供暖通风空调与电气"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 573,
  "num": "6.3.1",
  "kind": "clause",
  "text": "航站楼宜达到«民用机场航站楼能效评价指南» (MH/ T5112) 的能耗强度指标引导值；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 574,
  "num": "6.3.2",
  "kind": "clause",
  "text": "供暖空调冷源与热源系统应根据航站楼的规模、功能要求，建设地点的能源条件以及国"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 576,
  "num": "6.3.3",
  "kind": "clause",
  "text": "制冷站、热力站、变配电所应靠近负荷中心，以缩短管网、线路长度，降低输配系统"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 578,
  "num": "6.3.4",
  "kind": "clause",
  "text": "应合理选用高效的供暖、通风和空调系统，降低系统能耗；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 583,
  "num": "6.3.5",
  "kind": "clause",
  "text": "条件适宜地区宜合理采用蓄冷技术，节省空调系统运行费用，平衡电网负荷；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 584,
  "num": "6.3.6",
  "kind": "clause",
  "text": "供暖、通风和空调系统的设计及运行控制应采取与航班信息联动、分时、分区等节能"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 588,
  "num": "6.3.7",
  "kind": "clause",
  "text": "宜在航站楼登机桥固定端合适位置设置风幕，减少旅客进出时冷热量的损耗；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 589,
  "num": "6.3.8",
  "kind": "clause",
  "text": "冷热源设备能效值应高于«公共建筑节能设计标准» (GB50189) 的规定值，提高幅度"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 624,
  "num": "6.3.9",
  "kind": "clause",
  "text": "航站楼主要功能房间或场所的照明功率密度值宜符合«建筑照明设计标准» (GB50034)"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 626,
  "num": "6.3.10",
  "kind": "clause",
  "text": "航站楼宜根据使用需求采用智能化照明控制系统，实现分区、定时、感应、航班联动"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 634,
  "num": "6.3.11",
  "kind": "clause",
  "text": "在可能产生谐波等影响电源质量问题的场所应采取措施进行监测治理，避免造成电源"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 639,
  "num": "6.3.12",
  "kind": "clause",
  "text": "应选用高效节能电梯、自动扶梯及步道系统，采取电梯群控，扶梯、步道自动启停等"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 641,
  "num": "6.3.13",
  "kind": "clause",
  "text": "应选用节能高效的照明、动力设备，设备能效值宜分别符合下列规定:"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 663,
  "num": "6.4",
  "kind": "section",
  "text": "机场特种设备"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 664,
  "num": "6.4.1",
  "kind": "clause",
  "text": "应合理设计航站楼行李输送系统，尽可能减少运距，并选用节能的机电设备；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 665,
  "num": "6.4.2",
  "kind": "clause",
  "text": "应根据机场规模和使用需求，合理配置站坪地面动力装置和飞机预制冷空调系统；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 669,
  "num": "6.4.3",
  "kind": "clause",
  "text": "特种车辆宜采用清洁能源驱动车辆，并在合适区域设置充电桩等设施；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 680,
  "num": "7.1",
  "kind": "section",
  "text": "一般规定"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 681,
  "num": "7.1.1",
  "kind": "clause",
  "text": "应制定水资源利用方案，统筹利用各种水资源，减少自来水用水量和雨污水排放量；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 682,
  "num": "7.1.2",
  "kind": "clause",
  "text": "航站楼给水系统应充分利用市政压力ꎻ如需加压时，加压系统应选用节能高效设备；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 683,
  "num": "7.1.3",
  "kind": "clause",
  "text": "航站楼应设置完善的污水收集、处理设施，排入污水管网的污水水质应符合国家规定的"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 687,
  "num": "7.1.4",
  "kind": "clause",
  "text": "航站楼内应采用节水器具，节水器具使用率应达到100％；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 688,
  "num": "7.1.5",
  "kind": "clause",
  "text": "应制定航站楼水资源使用限额并安装水资源使用监测管理系统；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 693,
  "num": "7.2",
  "kind": "section",
  "text": "节水系统"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 694,
  "num": "7.2.1",
  "kind": "clause",
  "text": "航站楼生产、生活用水量按高峰小时旅客人次计算，综合用水定额计算宜采用10~20L/"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 696,
  "num": "7.2.2",
  "kind": "clause",
  "text": "应采取有效措施防止管网漏损，包括选用密闭性能好的阀门、设备ꎻ使用耐腐蚀、耐久"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 701,
  "num": "7.2.4",
  "kind": "clause",
  "text": "航站楼给水系统应对不同用途及不同付费或管理单元设置用水计量装置，计量装置安装"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 709,
  "num": "7.2.5",
  "kind": "clause",
  "text": "公用浴室应采用带恒温控制和温度显示的冷热水混合淋浴器，宜设置用者付费设施；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 710,
  "num": "7.3",
  "kind": "section",
  "text": "节水器具与设备"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 711,
  "num": "7.3.1",
  "kind": "clause",
  "text": "卫生器具应符合«节水型生活用水器具»"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 720,
  "num": "7.3.2",
  "kind": "clause",
  "text": "空调设备或系统应采用节水冷却技术；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 725,
  "num": "7.3.3",
  "kind": "clause",
  "text": "除卫生器具和冷却塔外的其他用水应采用节水技术或措施，其用水量比例宜不小"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 730,
  "num": "7.4",
  "kind": "section",
  "text": "非传统水源利用"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 731,
  "num": "7.4.1",
  "kind": "clause",
  "text": "航站楼内非传统水源的使用应通过技术经济性、卫生安全性比较分析后合理确定；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 734,
  "num": "7.4.2",
  "kind": "clause",
  "text": "航站楼制冷站冷却水补水宜采用非传统水源，其使用比例宜不小于10％，水质指标应满"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 736,
  "num": "7.4.3",
  "kind": "clause",
  "text": "航站楼屋面雨水收集应统一规划、合理利用，并设置控制雨水面源污染的措施；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 753,
  "num": "8.1",
  "kind": "section",
  "text": "一般规定"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 754,
  "num": "8.1.1",
  "kind": "clause",
  "text": "航站楼建设应使用绿色环保建筑材料及产品，不得使用国家和地方禁止和限制使用的建"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 756,
  "num": "8.1.2",
  "kind": "clause",
  "text": "航站楼改(扩) 建应对已有建筑物合理再利用；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 760,
  "num": "8.1.3",
  "kind": "clause",
  "text": "航站楼建筑造型要素应简约，装饰性构件的相应工程造价不超过工程总造价的5‰；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 767,
  "num": "8.1.4",
  "kind": "clause",
  "text": "在设计阶段，应明确各功能区的使用性质和要求，减少建设期间功能及材料的变更，避"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 774,
  "num": "8.1.5",
  "kind": "clause",
  "text": "在航站楼设计中，应实现标准化和模数化，减少材料浪费；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 786,
  "num": "8.2",
  "kind": "section",
  "text": "建筑设计与材料选用"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 787,
  "num": "8.2.1",
  "kind": "clause",
  "text": "应因地制宜地选择可再生材料，优先选用本地化建筑材料；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 788,
  "num": "8.2.2",
  "kind": "clause",
  "text": "航站楼中可能变换功能的室内空间宜采用可重复使用的隔断(墙) 进行分隔；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 793,
  "num": "8.2.3",
  "kind": "clause",
  "text": "应合理使用可再利用、可再循环和以废弃物为原料生产的建筑材料，其中可再利用材料"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 800,
  "num": "8.2.4",
  "kind": "clause",
  "text": "应选用环保性能高、挥发系数低、耐久性好和易维护的装修材料；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 804,
  "num": "8.2.5",
  "kind": "clause",
  "text": "宜选用工业化生产的装配式构件；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 816,
  "num": "9.1",
  "kind": "section",
  "text": "一般规定"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 817,
  "num": "9.1.1",
  "kind": "clause",
  "text": "航站楼外围护结构隔声量应不低于35dB；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 828,
  "num": "9.1.2",
  "kind": "clause",
  "text": "航站楼办公区域围护结构构件隔声量应达到«民用建筑隔声设计规范» (GB50118) 规"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 835,
  "num": "9.1.3",
  "kind": "clause",
  "text": "航站楼室内照明标准值应符合«建筑照明设计标准» (GB50034) 的有关规定；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 836,
  "num": "9.1.4",
  "kind": "clause",
  "text": "航站楼采用集中空调供暖系统时，室内的温度、湿度、新风量等设计参数应符合«民用"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 838,
  "num": "9.1.5",
  "kind": "clause",
  "text": "在室内设计温、湿度条件下，建筑围护结构内表面不得结露；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 839,
  "num": "9.1.6",
  "kind": "clause",
  "text": "屋顶和东、西外墙隔热性能应符合«民用建筑热工设计规范» (GB50176) 的有关规定；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 850,
  "num": "9.1.7",
  "kind": "clause",
  "text": "应合理设计航站楼空间、平面和构造，改善公共区域的自然通风效果；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 856,
  "num": "9.1.8",
  "kind": "clause",
  "text": "应结合航站楼不同空间特点和使用需求，开展气流组织设计，并符合下列规定:"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 873,
  "num": "9.1.9",
  "kind": "clause",
  "text": "室内空气中的氨、甲醛、苯、总挥发性有机物、氡等污染物浓度应符合«室内空气质量"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 875,
  "num": "9.2",
  "kind": "section",
  "text": "声环境"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 876,
  "num": "9.2.1",
  "kind": "clause",
  "text": "航站楼平面、空间应布局合理以减少内部噪声干扰；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 888,
  "num": "9.2.2",
  "kind": "clause",
  "text": "应采取以下减少噪声干扰的措施:"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 893,
  "num": "9.2.3",
  "kind": "clause",
  "text": "应对旅客聚集区及高大空间区进行专项声学设计，合理控制环境噪声，确保广播声音清"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 902,
  "num": "9.3",
  "kind": "section",
  "text": "光环境"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 903,
  "num": "9.3.1",
  "kind": "clause",
  "text": "航站楼设计应充分利用天然采光，并符合下列规定:"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 914,
  "num": "9.3.2",
  "kind": "clause",
  "text": "在进行采光设计时，应采取措施减少眩光，对设置有标识和屏显的区域应采用遮光设"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 926,
  "num": "9.4",
  "kind": "section",
  "text": "热环境"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 927,
  "num": "9.4.1",
  "kind": "clause",
  "text": "应采取合理的遮阳措施，降低夏季太阳辐射得热；外窗和幕墙透明部分中，有遮挡措施"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 932,
  "num": "9.4.2",
  "kind": "clause",
  "text": "宜采取通风装置或开窗控制，加强建筑内部的自然通风；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 937,
  "num": "9.4.3",
  "kind": "clause",
  "text": "根据各功能区域及旅客流程特点，合理设计空调分区和环境控制方法，并符合下列"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 944,
  "num": "9.5",
  "kind": "section",
  "text": "空气质量"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 945,
  "num": "9.5.1",
  "kind": "clause",
  "text": "旅客密集区域和需设置特殊隔离要求的区域应设置室内空气质量监控系统，并符合下列"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 959,
  "num": "9.5.2",
  "kind": "clause",
  "text": "应充分考虑垃圾转运流程，合理设置垃圾间，并符合下列规定:"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 970,
  "num": "10.1",
  "kind": "section",
  "text": "一般规定"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 971,
  "num": "10.1.1",
  "kind": "clause",
  "text": "航站楼人性化服务应做到以人为本，践行先进服务理念，打造高效服务流程，采用便"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 973,
  "num": "10.1.2",
  "kind": "clause",
  "text": "人性化服务应依据城市特点、航站楼规模、旅客需求等因素有效开展，并根据运行中"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 975,
  "num": "10.1.3",
  "kind": "clause",
  "text": "应设置满足不同群体的服务产品和设施，在确保安全的同时，提升航站楼内设施与服"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 977,
  "num": "10.1.4",
  "kind": "clause",
  "text": "应持续关注科技发展，不断开展和实践新科技在机场服务运行中的应用，建设智能化"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 979,
  "num": "10.1.5",
  "kind": "clause",
  "text": "应为老、幼、残、孕等特殊旅客提供绿色通道、爱心服务等专属服务产品，方便特殊"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 981,
  "num": "10.2",
  "kind": "section",
  "text": "自助服务"
 },
 {
