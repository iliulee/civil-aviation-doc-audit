  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 1076,
  "num": "10.6.1",
  "kind": "clause",
  "text": "应根据航站楼不同区域旅客的需求配备相应数量的座椅，且符合下列规定:"
 },
