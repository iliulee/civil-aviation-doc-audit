  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 1082,
  "num": "10.6.2",
  "kind": "clause",
  "text": "应在航站楼内合适区域设置设施齐全的母婴和儿童服务设施，并符合下列规定:"
 },
