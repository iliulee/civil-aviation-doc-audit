  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 1005,
  "num": "10.2.3",
  "kind": "clause",
  "text": "推广使用自助行李托运设备，提升值机效率；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 1006,
  "num": "10.2.4",
  "kind": "clause",
  "text": "在检验检疫、边防检查、海关检查等区域宜设置自助通关设备，提高旅客通关效率，"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 1008,
  "num": "10.2.5",
  "kind": "clause",
  "text": "推广使用自助登机设备，改善旅客登机秩序，提升旅客登机效率；"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 1009,
  "num": "10.3",
  "kind": "section",
  "text": "导向系统"
 },
 {
  "file": "2026-06-15-MH-T 5033-2017 绿色航站楼标准.md",
  "line": 1010,
  "num": "10.3.1",
  "kind": "clause",
  "text": "航站楼应进行导向系统专项设计；"
 },
