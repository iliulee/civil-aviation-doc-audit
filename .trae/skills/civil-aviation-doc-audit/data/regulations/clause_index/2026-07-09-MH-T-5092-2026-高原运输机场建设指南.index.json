 {
  "file": "2026-07-09-MH-T-5092-2026-高原运输机场建设指南.md",
  "line": 260,
  "num": "1.0.1",
  "kind": "clause",
  "text": "为指导高原运输机场的选址、规划、设计、施工，保证高原机场建设经济合理、安全适"
 },
 {
  "file": "2026-07-09-MH-T-5092-2026-高原运输机场建设指南.md",
  "line": 262,
  "num": "1.0.2",
  "kind": "clause",
  "text": "本指南适用于高原民用运输机场（含军民合用机场的民用部分）的新建、改建和扩建，"
 },
 {
  "file": "2026-07-09-MH-T-5092-2026-高原运输机场建设指南.md",
  "line": 264,
  "num": "1.0.3",
  "kind": "clause",
  "text": "高原运输机场的建设应充分考虑当地的地形地质、气象水文、生态保护、建筑材料、设"
 },
 {
  "file": "2026-07-09-MH-T-5092-2026-高原运输机场建设指南.md",
  "line": 266,
  "num": "1.0.4",
  "kind": "clause",
  "text": "高原运输机场建设应符合国家和行业现行有关标准的规定。"
 },
 {
  "file": "2026-07-09-MH-T-5092-2026-高原运输机场建设指南.md",
  "line": 273,
  "num": "2.1",
