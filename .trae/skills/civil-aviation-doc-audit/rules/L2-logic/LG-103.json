{
  "rule_id": "LG-103",
  "name": "分项 ≤ 分部 ≤ 单位工程验收日期",
  "level": "L2-LOGIC",
  "scope": "CROSS_DOC",
  "category": "时间轴一致性",
  "description": "验收顺序：分项 → 分部 → 单位，时间应顺向，不能跳跃。矛盾表现：分部验收日期早于分项验收日期，或单位工程验收日期早于分部验收日期。",
  "trigger_when": {
    "doc_type": ["分项工程质量验收记录", "分部工程质量验收记录", "单位工程质量验收记录"],
    "field_required": ["验收日期"]
  },
  "check_expr": {
    "type": "expression",
    "expr": "分项验收日期 <= 分部验收日期 and 分部验收日期 <= 单位工程验收日期",
    "language": "python_eval"
  },
  "error_template": "时间轴矛盾：分项验收 {分项验收日期}、分部验收 {分部验收日期}、单位工程验收 {单位工程验收日期} 顺序倒置",
  "severity_on_violation": "Fatal",
  "remediation": "核查各级验收日期是否填错，或验收程序倒签",
  "status": "active",
  "source": "system",
