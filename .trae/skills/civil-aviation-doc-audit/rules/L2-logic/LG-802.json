{
  "rule_id": "LG-802",
  "name": "检测项目齐全性",
  "level": "L2-LOGIC",
  "scope": "CROSS_DOC",
  "category": "试验检测一致性",
  "description": "规范要求检测的项目都应检测。矛盾表现：规范要求 8 项，报告只检 5 项。",
  "trigger_when": {
    "doc_type": ["试验检测报告", "规范要求清单"],
    "field_required": ["检测项目", "规范要求项目"]
  },
  "check_expr": {
    "type": "cross_compare",
    "expr": "set(规范要求项目).issubset(set(实际检测项目))",
    "language": "python_eval"
  },
  "error_template": "试验检测矛盾：规范要求检测项目 {规范要求项目}，实际报告仅检测 {实际检测项目}，缺失 {缺失项目}",
  "severity_on_violation": "Fatal",
  "remediation": "核查检测项目是否漏检，补做缺失项目检测",
  "status": "active",
  "source": "system",
  "version": "1.0.0",
