{
  "rule_id": "LG-105",
  "name": "设计变更日期 ≤ 实施日期",
  "level": "L2-LOGIC",
  "scope": "CROSS_DOC",
  "category": "时间轴一致性",
  "description": "设计变更必须先审批后实施。矛盾表现：已按变更施工但变更手续未下发，或施工实施日期早于变更审批日期。",
  "trigger_when": {
    "doc_type": ["设计变更通知单", "施工记录"],
    "field_required": ["变更编号", "审批日期", "实施日期"]
  },
  "check_expr": {
    "type": "expression",
    "expr": "设计变更审批日期 <= 实施日期",
    "language": "python_eval"
  },
  "error_template": "时间轴矛盾：设计变更 {变更编号} 审批日期 {设计变更审批日期}，但实施日期 {实施日期} 早于审批，未批先干",
  "severity_on_violation": "Fatal",
  "remediation": "核查变更审批手续是否补办，或实施日期填错",
  "status": "active",
  "source": "system",
