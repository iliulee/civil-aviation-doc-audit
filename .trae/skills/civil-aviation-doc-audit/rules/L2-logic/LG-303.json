{
  "rule_id": "LG-303",
  "name": "监理签字人员 = 派驻人员",
  "level": "L2-LOGIC",
  "scope": "CROSS_DOC",
  "category": "人员一致性",
  "description": "监理签字应有该人员在本项目的授权。矛盾表现：签字人未在本项目监理机构。",
  "trigger_when": {
    "doc_type": [
      "监理签字资料",
      "监理机构派驻名单"
    ],
    "field_required": [
      "签字人",
      "监理岗位"
    ]
  },
  "check_expr": {
    "type": "cross_compare",
    "expr": "all(签字人 in 监理机构派驻人员 for 签字人 in 监理签字人员)",
    "language": "python_eval"
  },
  "error_template": "人员矛盾：监理签字人 {签字人} 不在本项目监理机构派驻名单中",
  "severity_on_violation": "Fatal",
  "remediation": "核查监理签字是否冒名，或派驻名单是否更新",
  "status": "active",
  "source": "system",
