{
  "rule_id": "LG-401",
  "name": "同一检验批在不同资料中状态一致",
  "level": "L2-LOGIC",
  "scope": "CROSS_DOC",
  "category": "状态描述一致性",
  "description": "检验批、隐蔽记录、监理日志、影像中描述应一致。矛盾表现：检验批说\"合格\"，但监理日志说\"局部返工\"。",
  "trigger_when": {
    "doc_type": [
      "检验批质量验收记录",
      "隐蔽工程验收记录",
      "监理日志",
      "影像资料"
    ],
    "field_required": [
      "检验批编号",
      "质量状态"
    ]
  },
  "check_expr": {
    "type": "cross_compare",
    "expr": "all(质量状态 == 检验批质量状态 for 资料状态 in 同一检验批所有资料状态)",
    "language": "python_eval"
  },
  "error_template": "状态矛盾：检验批 {检验批编号} 在 {资料A} 中状态为 {状态A}，但在 {资料B} 中状态为 {状态B}",
  "severity_on_violation": "Sanity Check",
  "remediation": "核查各资料描述是否真实，必要时复验",
  "status": "active",
  "source": "system",
  "version": "1.0.0",
