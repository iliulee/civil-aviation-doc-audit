{
  "rule_id": "LG-607",
  "name": "合计值来源不明（铁律 13 配套）",
  "level": "L2-LOGIC",
  "scope": "CROSS_DOC",
  "category": "因果一致性",
  "description": "施工日志/汇总表有合计值，但原始施工记录无合计行 → 合计值来源不明。矛盾表现：DOC-C 记录\"33根，489.9m\"，但 DOC-B 6页全部缺合计行。结果：合计值无原始记录支撑，无法确认真实性。",
  "trigger_when": {
    "doc_type": [
      "施工日志",
      "施工记录",
      "汇总表"
    ],
    "field_required": [
      "合计值",
      "合计行"
    ]
  },
  "check_expr": {
    "type": "cross_compare",
    "expr": "not (存在合计值 in 施工日志 and not 存在合计行 in 施工记录)",
    "language": "python_eval"
  },
  "error_template": "因果矛盾：{汇总资料} 有合计值 {合计值}，但原始施工记录 {原始记录} 无合计行，合计值来源不明",
  "severity_on_violation": "Sanity Check",
  "remediation": "调取原始施工记录核实，若原始记录已丢失需补充说明",
