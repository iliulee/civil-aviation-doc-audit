{
  "rule_id": "LG-501",
  "name": "同一签字人笔迹稳定性",
  "level": "L2-LOGIC",
  "scope": "CROSS_DOC",
  "category": "签字一致性",
  "description": "同一签字人在不同时间的笔迹应稳定，可通过 OCR 文字提取 + 视觉对比。矛盾表现：同一人签字笔迹差异显著，疑似代签。",
  "trigger_when": {
    "doc_type": ["*"],
    "field_required": ["签字人", "签字日期", "签字图像"]
  },
  "check_expr": {
    "type": "cross_compare",
    "expr": "all(笔迹相似度(签字A, 签字B) >= 0.85 for 签字A, 签字B in 同一签字人不同时间笔迹)",
    "language": "python_eval"
  },
  "error_template": "签字矛盾：签字人 {签字人} 在 {日期A} 与 {日期B} 的笔迹相似度 {相似度} 低于阈值 0.85，笔迹不稳定",
  "severity_on_violation": "Sanity Check",
  "remediation": "核查是否代签，必要时调取本人确认",
  "status": "active",
  "source": "system",
  "version": "1.0.0",
