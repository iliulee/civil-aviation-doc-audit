{
  "rule_id": "CU-014",
  "name": "危大工程：方案审查 → 专家论证 → 验收",
  "level": "L2-LOGIC",
  "scope": "CROSS_UNIT",
  "category": "跨单位日期对照",
  "description": "危大工程流程：专项施工方案内部编制日期 ≤ 监理审查日期 ≤ 专家论证日期（如需）≤ 实施日期 ≤ 验收日期。实施日期早于审查/论证日期（未批先干），或验收日期早于实施日期均为矛盾。跨单位核心校验为监理审查日期 ≥ 施工编制日期",
  "trigger_when": {
    "doc_type_a": "专项方案监理审查记录",
    "doc_type_b": "专项施工方案",
    "require_both": true
  },
  "alignment": {
    "party_a": {
      "role": "supervisor",
      "label": "监理方",
      "doc_type": "专项方案监理审查记录"
    },
    "party_b": {
      "role": "contractor",
      "label": "施工方",
      "doc_type": "专项施工方案"
    },
    "join_key": [
      "项目编号",
      "方案编号"
    ],
    "field_a": "监理审查日期",
    "field_b": "编制日期",
    "aggregation": "none"
  },
  "check_expr": {
    "type": "cross_compare",
    "expr": "field_a >= field_b",
    "language": "python_eval"
  },
  "error_template": "危大工程监理审查日期 {field_a} 早于方案编制日期 {field_b}，或实施日期早于审查/论证日期（未批先干）",
  "severity_on_violation": "Sanity Check",
  "confirmation_required": true,
  "confirmation_scope": "both_parties_or_admin",
  "remediation": "核查方案编制、监理审查、专家论证、实施、验收各环节日期顺序",
