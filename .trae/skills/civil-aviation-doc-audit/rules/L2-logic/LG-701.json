{
  "rule_id": "LG-701",
  "name": "同一项目规范版本统一",
  "level": "L2-LOGIC",
  "scope": "CROSS_DOC",
  "category": "规范引用一致性",
  "description": "同类资料应引用同一版本规范。矛盾表现：A检验批引 MH 5007-2017，B检验批引 MH 5007-2009。",
  "trigger_when": {
    "doc_type": [
      "检验批质量验收记录",
      "施工记录",
      "检测报告"
    ],
    "field_required": [
      "规范编号",
      "规范版本"
    ]
  },
  "check_expr": {
    "type": "cross_compare",
    "expr": "len(set(规范版本 for 规范版本 in 同类资料)) == 1",
    "language": "python_eval"
  },
  "error_template": "规范引用矛盾：{规范名称} 在 {资料A} 引用版本 {版本A}，在 {资料B} 引用版本 {版本B}，版本不统一",
  "severity_on_violation": "Sanity Check",
  "remediation": "核查应统一引用最新有效版本规范，旧版资料需说明或修订",
