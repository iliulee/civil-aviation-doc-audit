{
  "rule_id": "LG-006",
  "name": "沉管时间完整性校验",
  "level": "L2-LOGIC",
  "scope": "SINGLE_DOC",
  "category": "数据完整性",
  "description": "碎石桩施工记录必须有沉管时间，不能为空",

  "trigger_when": {
    "doc_type": ["碎石桩施工记录"],
    "field_required": ["沉管时间"]
  },

  "check_expr": {
    "type": "expression",
    "expr": "沉管时间 is not None and str(沉管时间).strip() != ''",
    "language": "jinja-expr",
    "fallback": "python_eval"
  },

  "error_template": "桩号 {pile_no} 缺少沉管时间，碎石桩施工记录必须记录每根桩的沉管时间",

  "severity_on_violation": "Sanity Check",
  "remediation": "补充沉管时间记录，核查施工记录是否遗漏",

  "status": "active",
