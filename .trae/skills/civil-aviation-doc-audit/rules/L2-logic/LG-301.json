{
  "rule_id": "LG-301",
  "name": "施工日志人员 = 作业班组 = 考勤表",
  "level": "L2-LOGIC",
  "scope": "CROSS_DOC",
  "category": "人员一致性",
  "description": "三处出现的人员名单应一致：施工日志记录的人员、实际作业班组、考勤表。矛盾表现：施工日志写\"张三班组\"，考勤表无此人。",
  "trigger_when": {
    "doc_type": ["施工日志", "班组记录", "考勤表"],
    "field_required": ["人员姓名", "日期"]
  },
  "check_expr": {
    "type": "cross_compare",
    "expr": "set(施工日志人员) == set(考勤表人员) and set(施工日志人员) == set(作业班组人员)",
    "language": "python_eval"
  },
  "error_template": "人员矛盾：施工日志人员 {施工日志人员} 与考勤表 {考勤表人员} 或作业班组 {作业班组人员} 不一致",
  "severity_on_violation": "Sanity Check",
  "remediation": "核查人员是否漏记或冒名顶替",
  "status": "active",
  "source": "system",
