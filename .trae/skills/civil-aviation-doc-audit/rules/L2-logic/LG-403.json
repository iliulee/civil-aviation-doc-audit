{
  "rule_id": "LG-403",
  "name": "质量评估等级与检测数据匹配",
  "level": "L2-LOGIC",
  "scope": "CROSS_DOC",
  "category": "状态描述一致性",
  "description": "评为\"优良\"应数据支撑；评为\"合格\"应无主控项目不合格。矛盾表现：评为\"优良\"但合格率低。",
  "trigger_when": {
    "doc_type": [
      "质量评估报告",
      "检验批质量验收记录",
      "检测报告"
    ],
    "field_required": [
      "评估等级",
      "合格率",
      "主控项目"
    ]
  },
  "check_expr": {
    "type": "cross_compare",
    "expr": "(评估等级=='优良' implies 合格率>=0.9) and (评估等级=='合格' implies not exists(主控项目 where 结果=='不合格'))",
    "language": "python_eval"
  },
  "error_template": "状态矛盾：评估等级 {评估等级}，但合格率 {合格率} 或存在主控项目不合格 {不合格主控项目}，等级评定无数据支撑",
  "severity_on_violation": "Sanity Check",
  "remediation": "核查评估等级是否虚高，或检测数据是否漏检",
  "status": "active",
  "source": "system",
  "version": "1.0.0",
