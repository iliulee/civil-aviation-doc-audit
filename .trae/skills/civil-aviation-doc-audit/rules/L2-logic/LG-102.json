{
  "rule_id": "LG-102",
  "name": "隐蔽工程验收日期 ≤ 下道工序开工日期",
  "level": "L2-LOGIC",
  "scope": "CROSS_DOC",
  "category": "时间轴一致性",
  "description": "隐蔽工程必须先验收再覆盖。矛盾表现：下道工序已开工但隐蔽工程验收记录未形成，或下道工序开工日期早于隐蔽验收日期。",
  "trigger_when": {
    "doc_type": [
      "隐蔽工程验收记录",
      "下道工序施工记录"
    ],
    "field_required": [
      "日期"
    ]
  },
  "check_expr": {
    "type": "expression",
    "expr": "隐蔽工程验收日期 <= 下道工序开工日期",
    "language": "python_eval"
  },
  "error_template": "时间轴矛盾：隐蔽工程 {隐蔽部位} 验收日期 {隐蔽工程验收日期}，但下道工序开工日期 {下道工序开工日期}，未先验收即覆盖",
  "severity_on_violation": "Fatal",
  "remediation": "核查隐蔽验收是否漏签或下道工序提前施工，必要时返工复验",
