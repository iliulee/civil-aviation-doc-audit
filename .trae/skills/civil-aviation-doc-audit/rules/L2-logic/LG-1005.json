{
  "rule_id": "LG-1005",
  "name": "时间连续性校验（DQ-SELF）",
  "level": "L2-LOGIC",
  "scope": "SINGLE_DOC",
  "category": "数据自洽",
  "description": "时间连续性校验：后行开始时间 ≥ 前行结束时间，允许误差 0。不通过 → 时间倒挂。",
  "trigger_when": {
    "doc_type": ["碎石桩施工记录", "DDC桩施工记录", "PHC管桩施工记录", "混凝土浇筑记录"],
    "field_required": ["开始时间", "结束时间"]
  },
  "check_expr": {
    "type": "expression",
    "expr": "all(后行开始时间 >= 前行结束时间 for 相邻行 in 施工记录)",
    "language": "python_eval"
  },
  "error_template": "时间连续性失败：前行 {前行桩号} 结束时间 {前行结束时间}，后行 {后行桩号} 开始时间 {后行开始时间}，时间倒挂",
  "severity_on_violation": "Sanity Check",
  "remediation": "核查时间记录是否填错，或施工顺序记录错误",
