{
  "rule_id": "LG-306",
  "name": "项目经理/总监变更有正式手续",
  "level": "L2-LOGIC",
  "scope": "CROSS_DOC",
  "category": "人员一致性",
  "description": "变更应有正式手续，前后职责交接清晰。矛盾表现：新经理已签字但无变更手续。",
  "trigger_when": {
    "doc_type": [
      "项目经理变更通知",
      "总监变更通知",
      "签字资料"
    ],
    "field_required": [
      "签字人",
      "签字日期",
      "变更批准日期"
    ]
  },
  "check_expr": {
    "type": "cross_compare",
    "expr": "exists(变更通知 where 变更批准日期 <= 签字日期 and 新任人员 == 签字人) or 签字人 == 原任人员",
    "language": "python_eval"
  },
  "error_template": "人员矛盾：新任 {岗位} {签字人} 在 {签字日期} 已签字，但变更手续批准日期 {变更批准日期} 晚于签字日期或无变更手续",
  "severity_on_violation": "Fatal",
  "remediation": "核查变更手续是否补办，或签字时间填错",
  "status": "active",
  "source": "system",
  "version": "1.0.0",
