{
  "rule_id": "LG-1004",
  "name": "桩号连续性校验（DQ-SELF，铁律 16 配套）",
  "level": "L2-LOGIC",
  "scope": "SINGLE_DOC",
  "category": "数据自洽",
  "description": "桩号连续性校验：桩号总数 = 设计总桩数（顺序按现场施工顺序，不强制连号），允许误差 0。不通过 → 缺桩或重号。",
  "trigger_when": {
    "doc_type": [
      "碎石桩施工记录",
      "DDC桩施工记录",
      "PHC管桩施工记录",
      "CFG桩施工记录"
    ],
    "field_required": [
      "桩号",
      "设计总桩数"
    ]
  },
  "check_expr": {
    "type": "expression",
    "expr": "count(桩号) == 设计总桩数 and len(set(桩号)) == len(桩号)",
    "language": "python_eval"
  },
  "error_template": "桩号连续性失败：设计总桩数 {设计总桩数}，实际记录桩号 {实际桩数} 个，差异 {差异值}；{重号桩号或缺失桩号}",
  "severity_on_violation": "Fatal",
  "remediation": "核查是否缺桩或重号，补全或更正桩号记录",
  "status": "active",
  "source": "system",
  "version": "1.0.0",
