{
  "rule_id": "LG-201",
  "name": "检验批工程量累计 = 分项工程工程量",
  "level": "L2-LOGIC",
  "scope": "CROSS_DOC",
  "category": "数量累计一致性",
  "description": "各检验批工程量加起来应等于分项工程总量。矛盾表现：差值 > 5%（允许施工误差）。",
  "trigger_when": {
    "doc_type": [
      "检验批质量验收记录",
      "分项工程质量验收记录"
    ],
    "field_required": [
      "工程量"
    ]
  },
  "check_expr": {
    "type": "aggregation",
    "expr": "abs(sum(检验批工程量) - 分项工程量) / 分项工程量 <= 0.05",
    "language": "python_eval"
  },
  "error_template": "数量累计矛盾：分项 {分项名称} 检验批累计工程量 {累计工程量}，分项工程总量 {分项工程量}，差异 {diff_pct}% 超出 ±5%",
  "severity_on_violation": "Sanity Check",
  "remediation": "核查检验批是否漏报或多报，或分项总量填错",
  "status": "active",
  "source": "system",
