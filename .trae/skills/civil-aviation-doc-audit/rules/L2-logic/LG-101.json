{
  "rule_id": "LG-101",
  "name": "检验批日期 ≥ 材料进场日期 ≥ 材料报审日期",
  "level": "L2-LOGIC",
  "scope": "CROSS_DOC",
  "category": "时间轴一致性",
  "description": "材料报审日期（监理审批日期）应在材料使用前；材料进场日期应在报审合格后；检验批使用该材料的日期应在进场之后。矛盾表现：使用日期早于进场日期，或进场日期早于报审日期。典型场景：钢筋焊接检验批日期 = 2024-03-15，钢筋进场日期 = 2024-03-18，矛盾：用了还没进场的钢筋。",
  "trigger_when": {
    "doc_type": ["检验批", "材料进场记录", "材料报审表"],
    "field_required": ["日期", "材料名称"]
  },
  "check_expr": {
    "type": "expression",
    "expr": "检验批日期 >= 材料进场日期 and 材料进场日期 >= 材料报审日期",
    "language": "python_eval"
  },
  "error_template": "时间轴矛盾：{材料名称} 报审日期 {材料报审日期}，进场日期 {材料进场日期}，检验批日期 {检验批日期}，使用早于进场或进场早于报审",
  "severity_on_violation": "Sanity Check",
  "remediation": "核查日期是否填错，或流程是否倒签",
  "status": "active",
  "source": "system",
