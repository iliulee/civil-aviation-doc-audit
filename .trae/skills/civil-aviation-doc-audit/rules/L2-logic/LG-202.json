{
  "rule_id": "LG-202",
  "name": "分项工程量累计 = 分部工程量",
  "level": "L2-LOGIC",
  "scope": "CROSS_DOC",
  "category": "数量累计一致性",
  "description": "同 9.2.1，向上累计。各分项工程量加起来应等于分部工程总量，差值不应超出施工误差范围。",
  "trigger_when": {
    "doc_type": [
      "分项工程质量验收记录",
      "分部工程质量验收记录"
    ],
    "field_required": [
      "工程量"
    ]
  },
  "check_expr": {
    "type": "aggregation",
    "expr": "abs(sum(分项工程量) - 分部工程量) / 分部工程量 <= 0.05",
    "language": "python_eval"
  },
  "error_template": "数量累计矛盾：分部 {分部名称} 分项累计工程量 {累计工程量}，分部工程总量 {分部工程量}，差异 {diff_pct}% 超出 ±5%",
  "severity_on_violation": "Sanity Check",
  "remediation": "核查分项是否漏报或多报，或分部总量填错",
  "status": "active",
  "source": "system",
