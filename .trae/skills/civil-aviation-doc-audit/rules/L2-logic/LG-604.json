{
  "rule_id": "LG-604",
  "name": "验收问题闭环",
  "level": "L2-LOGIC",
  "scope": "CROSS_DOC",
  "category": "因果一致性",
  "description": "验收提出问题 → 整改 → 复验 → 通过。矛盾表现：验收有未关闭问题但已签字。",
  "trigger_when": {
    "doc_type": ["验收记录", "整改通知单", "复验记录"],
    "field_required": ["验收编号", "问题清单", "签字"]
  },
  "check_expr": {
    "type": "cross_compare",
    "expr": "not exists(未关闭问题) or not exists(验收签字)",
    "language": "python_eval"
  },
  "error_template": "因果矛盾：验收 {验收编号} 存在未关闭问题 {未关闭问题}，但已签字通过",
  "severity_on_violation": "Fatal",
  "remediation": "核查验收签字是否违规，或问题已闭环但未记录",
