{
  "rule_id": "LG-402",
  "name": "不合格项整改闭环",
  "level": "L2-LOGIC",
  "scope": "CROSS_DOC",
  "category": "状态描述一致性",
  "description": "不合格 → 整改通知 → 整改实施 → 复验合格，闭环。矛盾表现：只有\"不合格\"，无后续整改记录。",
  "trigger_when": {
    "doc_type": [
      "检验批质量验收记录",
      "不合格记录",
      "整改通知单",
      "整改回复单",
      "复验记录"
    ],
    "field_required": [
      "不合格项编号",
      "整改状态"
    ]
  },
  "check_expr": {
    "type": "cross_compare",
    "expr": "all(exists(整改通知单 and 整改回复单 and 复验记录 where 复验结果=='合格') for 不合格项 in 不合格记录)",
    "language": "python_eval"
  },
  "error_template": "状态矛盾：不合格项 {不合格项编号} 无后续整改记录或复验未闭环",
  "severity_on_violation": "Fatal",
  "remediation": "核查整改记录是否缺失，或复验是否漏做",
  "status": "active",
  "source": "system",
  "version": "1.0.0",
