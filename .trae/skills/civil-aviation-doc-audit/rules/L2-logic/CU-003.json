{
  "rule_id": "CU-003",
  "name": "复工令日期 ≥ 复工报审表日期 ≥ 暂停令签发日期",
  "level": "L2-LOGIC",
  "scope": "CROSS_UNIT",
  "category": "跨单位日期对照",
  "description": "复工流程闭环：暂停令（A.11）签发日期 ≤ 施工单位《复工报审表》（B.26）申请日期 ≤ 监理签发《复工令》（A.15）日期。跨单位核心校验为复工令日期 ≥ 复工报审表日期",
  "trigger_when": {
    "doc_type_a": "复工令",
    "doc_type_b": "复工报审表",
    "require_both": true
  },
  "alignment": {
    "party_a": {
      "role": "supervisor",
      "label": "监理方",
      "doc_type": "复工令"
    },
    "party_b": {
      "role": "contractor",
      "label": "施工方",
      "doc_type": "复工报审表"
    },
    "join_key": [
      "项目编号"
    ],
    "field_a": "复工令日期",
    "field_b": "报审表日期",
    "aggregation": "none"
  },
  "check_expr": {
    "type": "cross_compare",
    "expr": "field_a >= field_b",
    "language": "python_eval"
  },
  "error_template": "复工令日期 {field_a} 早于复工报审表日期 {field_b}，流程倒签（未申请就批准）或复工报审早于暂停令（没停就申请复工）",
  "severity_on_violation": "Sanity Check",
  "confirmation_required": true,
  "confirmation_scope": "both_parties_or_admin",
  "remediation": "核查暂停令、复工报审、复工令三者日期顺序是否正确",
