{
  "rule_id": "LG-703",
  "name": "规范引用与内容相关",
  "level": "L2-LOGIC",
  "scope": "CROSS_DOC",
  "category": "规范引用一致性",
  "description": "引用的规范条款应与资料内容相关。矛盾表现：路基资料引用桥梁规范。",
  "trigger_when": {
    "doc_type": ["检验批质量验收记录", "施工记录", "检测报告"],
    "field_required": ["规范编号", "资料内容分类"]
  },
  "check_expr": {
    "type": "cross_compare",
    "expr": "all(规范适用专业 == 资料内容专业 for 规范引用 in 所有规范引用)",
    "language": "python_eval"
  },
  "error_template": "规范引用矛盾：{资料类型} {资料编号} 内容属 {资料内容专业}，但引用规范 {规范编号} 适用 {规范适用专业}，专业不匹配",
  "severity_on_violation": "Sanity Check",
  "remediation": "核查规范引用是否填错，更换为对应专业规范",
