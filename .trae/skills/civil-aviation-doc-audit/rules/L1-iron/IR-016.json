{
  "rule_id": "IR-016",
  "name": "提取-验证-重试",
  "level": "L1-IRON",
  "scope": "SINGLE_DOC",
  "category": "数据校验",
  "description": "提取完成后必须先做行数校验（预期 vs 实际），不通过触发 AI 视觉重新提取（换读取方式，不修改 OCR 参数）；重试仍失败标记\"提取不完整，数据不可靠\"停止后续审核。行数校验通过后做桩号连续性校验（不能跳号如 Z420→Z418 缺 Z419）。所有提取操作必须记录版本号（提取方式、时间、置信度）方便追溯。由提取系统执行。",
  "trigger_when": {
    "doc_type": [
      "*"
    ],
    "field_required": []
  },
  "check_expr": {
    "type": "expression",
    "expr": "True",
    "language": "python_eval"
  },
  "error_template": "提取完整性校验失败（行数不匹配或桩号跳号）：{issue}",
  "severity_on_violation": "Fatal",
  "remediation": "重新提取数据，必要时换引擎或读取方式；记录提取版本号方便追溯",
