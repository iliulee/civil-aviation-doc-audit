{
  "rule_id": "IR-017",
  "name": "合计值反向验证",
  "level": "L1-IRON",
  "scope": "CROSS_DOC",
  "category": "数据校验",
  "description": "当施工日志/汇总表有合计值时，必须与施工记录实际数据逐项核对。对比结果分类：一致=可信；不一致=标记\"合计值存疑\"记录差异值；施工记录无合计行=标记\"合计值来源不明\"。合计值来源不明的资料，在审核结论中不下\"数据合格\"结论。缺合计行+有合计值同时出现时形成最高优先级审计线索。",
  "trigger_when": {
    "doc_type": [
      "施工日志",
      "施工记录",
      "汇总表"
    ],
    "field_required": [
      "合计值"
    ]
  },
  "check_expr": {
    "type": "expression",
    "expr": "True",
    "language": "python_eval"
  },
  "error_template": "合计值反向验证失败：{issue}",
  "severity_on_violation": "Fatal",
  "remediation": "逐页核对施工记录实际合计与施工日志合计值；无合计行标记\"合计值来源不明\"不下合格结论",
