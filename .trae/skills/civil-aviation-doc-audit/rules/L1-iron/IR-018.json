{
  "rule_id": "IR-018",
  "name": "置信度分级",
  "level": "L1-IRON",
  "scope": "SINGLE_DOC",
  "category": "合规底线",
  "description": "所有审核结论必须标注置信度，分四级：高（有原始记录支撑且多份资料一致，表述\"确定\"）、中（有原始记录但仅单份，表述\"基本确定\"）、低（无原始记录仅誊抄件，表述\"初步判断\"）、存疑（多份资料数据矛盾或数据自洽失败，表述\"数据存疑，建议现场验证\"）。存疑数据不下确定性结论，必须标注\"建议现场验证\"。",
  "trigger_when": {
    "doc_type": [
      "*"
    ],
    "field_required": []
  },
  "check_expr": {
    "type": "expression",
    "expr": "True",
    "language": "python_eval"
  },
  "error_template": "审核结论未标注置信度或存疑项下了确定性结论：{issue}",
  "severity_on_violation": "Fatal",
  "remediation": "对所有不符合项标注置信度（高/中/低/存疑）；存疑项必须标注\"建议现场验证\"",
