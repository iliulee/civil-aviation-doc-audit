{
  "rule_id": "IR-015",
  "name": "原始底稿追溯",
  "level": "L1-IRON",
  "scope": "CROSS_DOC",
  "category": "数据校验",
  "description": "同一桩号/条目在多份资料中数据矛盾时，不盲目采信任何一份，优先追溯原始记录（现场手写底稿、监理旁站记录、原始测量记录）。原始记录不可获取时按\"三个一致\"原则判断（工程逻辑/时间顺序/多资料交叉验证）。争议数据做标注，不在审核报告中下\"确定\"结论，改为\"数据存疑，建议现场验证\"。",
  "trigger_when": {
    "doc_type": [
      "*"
    ],
    "field_required": []
  },
  "check_expr": {
    "type": "expression",
    "expr": "True",
    "language": "python_eval"
  },
  "error_template": "多资料数据矛盾未追溯原始底稿即下确定结论：{issue}",
  "severity_on_violation": "Fatal",
  "remediation": "追溯原始记录或现场取芯验证；争议数据标注\"存疑\"不下确定结论",
