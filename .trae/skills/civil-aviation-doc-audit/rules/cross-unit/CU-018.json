{
  "rule_id": "CU-018",
  "name": "监理例会/专题会议：会议日期 vs 议定事项时限",
  "level": "L2-LOGIC",
  "scope": "CROSS_UNIT",
  "category": "跨单位日期对照",
  "description": "监理例会/专题会议流程：会议纪要日期 ≤ 议定事项完成时限。议定事项应有完成状态记录（已完成/进行中/未启动）。议定事项完成时限早于会议日期，或已过时限但无完成记录均为矛盾",
  "trigger_when": {
    "doc_type_a": "监理例会纪要",
    "doc_type_b": "议定事项落实记录",
    "require_both": true
  },
  "alignment": {
    "party_a": {
      "role": "supervisor",
      "label": "监理方",
      "doc_type": "监理例会纪要"
    },
    "party_b": {
      "role": "contractor",
      "label": "施工方",
      "doc_type": "议定事项落实记录"
    },
    "join_key": ["项目编号", "会议编号", "议定事项编号"],
    "field_a": "会议日期",
    "field_b": "完成时限",
    "aggregation": "none"
  },
  "check_expr": {
    "type": "cross_compare",
    "expr": "field_b >= field_a",
    "language": "python_eval"
  },
  "error_template": "议定事项完成时限 {field_b} 早于会议日期 {field_a}，或已过时限但无完成记录",
  "severity_on_violation": "Sanity Check",
  "confirmation_required": true,
  "confirmation_scope": "both_parties_or_admin",
  "remediation": "核查会议日期与议定事项完成时限的先后顺序，及已完成事项是否有闭环记录",
  "status": "active",
  "source": "system",
