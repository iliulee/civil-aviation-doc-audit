{
  "rule_id": "CU-004",
  "name": "工程延期报审：事件日期 → 申请日期 → 批准日期",
  "level": "L2-LOGIC",
  "scope": "CROSS_UNIT",
  "category": "跨单位日期对照",
  "description": "工程延期报审流程：索赔事件发生日期 ≤ 事件结束日期 ≤ 施工单位《工程延期报审表》（B.28）申请日期 ≤ 监理批准日期。申请延期天数应与事件持续天数逻辑匹配。跨单位核心校验为监理批准日期 ≥ 施工申请日期",
  "trigger_when": {
    "doc_type_a": "工程延期报审表",
    "doc_type_b": "工程延期报审表",
    "require_both": true
  },
  "alignment": {
    "party_a": {
      "role": "supervisor",
      "label": "监理方",
      "doc_type": "工程延期报审表"
    },
    "party_b": {
      "role": "contractor",
      "label": "施工方",
      "doc_type": "工程延期报审表"
    },
    "join_key": ["项目编号"],
    "field_a": "批准日期",
    "field_b": "申请日期",
    "aggregation": "none"
  },
  "check_expr": {
    "type": "cross_compare",
    "expr": "field_a >= field_b",
    "language": "python_eval"
  },
  "error_template": "工程延期报审批准日期 {field_a} 早于申请日期 {field_b}，或申请日期早于事件结束日期，流程倒签",
  "severity_on_violation": "Sanity Check",
  "confirmation_required": true,
  "confirmation_scope": "both_parties_or_admin",
  "remediation": "核查延期事件日期、申请日期、批准日期顺序，及延期天数与事件持续天数是否匹配",
  "status": "active",
