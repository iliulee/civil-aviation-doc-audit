{
  "rule_id": "IR-002",
  "name": "OCR 必复核",
  "level": "L1-IRON",
  "scope": "SINGLE_DOC",
  "category": "数据校验",
  "description": "扫描件 OCR 识别结果仅辅助参考，涉及数据、参数、签章的必须提示人工复核。阶段 2（人工核对）是硬闸门，未完成核对前 human_verified=false，阶段 3 的审核脚本会拒绝执行。人工执行要点：扫描件 OCR 完成后必须停下输出待核实清单，等用户确认或修正后才进入数据质量检测。",
  "trigger_when": {
    "doc_type": [
      "*"
    ],
    "field_required": [
      "ocr_status"
    ]
  },
  "check_expr": {
