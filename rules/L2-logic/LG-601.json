{
  "rule_id": "LG-601",
  "name": "质量问题必须有闭环处理",
  "level": "L2-LOGIC",
  "scope": "CROSS_DOC",
  "category": "因果一致性",
  "description": "出现问题 → 整改/加固/变更/返工。矛盾表现：记录中提到质量问题，无后续处理。",
  "trigger_when": {
    "doc_type": ["质量问题记录", "整改通知单", "整改回复单", "复验记录"],
    "field_required": ["质量问题编号", "处理状态"]
  },
  "check_expr": {
    "type": "cross_compare",
    "expr": "all(exists(整改通知单 and 整改回复单 and 复验记录) for 质量问题 in 质量问题记录)",
    "language": "python_eval"
  },
  "error_template": "因果矛盾：质量问题 {质量问题编号} {问题描述} 无后续整改/加固/变更/返工记录，未闭环",
  "severity_on_violation": "Fatal",
  "remediation": "核查整改记录是否缺失，或质量问题未处理",
  "status": "active",
  "source": "system",
