{
  "rule_id": "CU-017",
  "name": "第一次工地会议纪要日期 ≤ 开工日期",
  "level": "L2-LOGIC",
  "scope": "CROSS_DOC",
  "category": "跨单位日期对照",
  "description": "第一次工地会议召开日期 ≤ 工程开工日期。会议纪要日期标志着监理工作正式启动，应在开工之前。开工日期早于第一次工地会议日期（先开工后开会）为矛盾",
  "trigger_when": {
    "doc_type_a": "第一次工地会议纪要",
    "doc_type_b": "开工报审表",
    "require_both": true
  },
  "alignment": {
    "party_a": {
      "role": "supervisor",
      "label": "监理方",
      "doc_type": "第一次工地会议纪要"
    },
    "party_b": {
      "role": "contractor",
      "label": "施工方",
      "doc_type": "开工报审表"
    },
    "join_key": [
      "项目编号"
    ],
    "field_a": "会议日期",
    "field_b": "开工日期",
    "aggregation": "none"
  },
  "check_expr": {
    "type": "cross_compare",
    "expr": "field_a <= field_b",
    "language": "python_eval"
  },
  "error_template": "第一次工地会议纪要日期 {field_a} 晚于开工日期 {field_b}（先开工后开会），监理工作未正式启动即开工",
  "severity_on_violation": "Sanity Check",
  "confirmation_required": true,
  "confirmation_scope": "both_parties_or_admin",
  "remediation": "核查第一次工地会议召开日期与工程开工日期的先后顺序",
