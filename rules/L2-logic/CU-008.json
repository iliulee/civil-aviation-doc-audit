{
  "rule_id": "CU-008",
  "name": "竣工验收申请：预验收 → 整改 → 申请",
  "level": "L2-LOGIC",
  "scope": "CROSS_UNIT",
  "category": "跨单位日期对照",
  "description": "竣工验收申请流程：竣工预验收完成日期 ≤ 整改完成日期 ≤ 《竣工验收申请表》（B.21）申请日期。预验收提出的问题应全部闭环后才能申请竣工验收。跨单位核心校验为施工申请日期 ≥ 监理预验收完成日期",
  "trigger_when": {
    "doc_type_a": "竣工预验收记录",
    "doc_type_b": "竣工验收申请表",
    "require_both": true
  },
  "alignment": {
    "party_a": {
      "role": "supervisor",
      "label": "监理方",
      "doc_type": "竣工预验收记录"
    },
    "party_b": {
      "role": "contractor",
      "label": "施工方",
      "doc_type": "竣工验收申请表"
    },
    "join_key": [
      "项目编号"
    ],
    "field_a": "预验收完成日期",
    "field_b": "申请日期",
    "aggregation": "none"
  },
  "check_expr": {
    "type": "cross_compare",
    "expr": "field_b >= field_a",
    "language": "python_eval"
  },
  "error_template": "竣工验收申请日期 {field_b} 早于预验收完成日期 {field_a}，或预验收问题未闭环就申请",
  "severity_on_violation": "Sanity Check",
  "confirmation_required": true,
  "confirmation_scope": "both_parties_or_admin",
  "remediation": "核查预验收完成日期、整改完成日期、申请日期顺序，及预验收问题是否全部闭环",
