{
  "rule_id": "LG-203",
  "name": "分部工程量累计 = 单位工程量 ≈ 竣工图工程量",
  "level": "L2-LOGIC",
  "scope": "CROSS_DOC",
  "category": "数量累计一致性",
  "description": "累计到单位工程应与合同/竣工图基本一致。差异 > 3% 应说明原因。",
  "trigger_when": {
    "doc_type": [
      "分部工程质量验收记录",
      "单位工程质量验收记录",
      "竣工图"
    ],
    "field_required": [
      "工程量"
    ]
  },
  "check_expr": {
    "type": "aggregation",
    "expr": "abs(sum(分部工程量) - 单位工程量) / 单位工程量 <= 0.03 and abs(单位工程量 - 竣工图工程量) / 竣工图工程量 <= 0.03",
    "language": "python_eval"
  },
  "error_template": "数量累计矛盾：分部累计 {累计工程量}，单位工程量 {单位工程量}，竣工图工程量 {竣工图工程量}，差异 {diff_pct}% 超出 ±3% 未说明原因",
  "severity_on_violation": "Sanity Check",
  "remediation": "核查分部是否漏报，或与合同/竣工图差异原因并补充说明",
  "status": "active",
  "source": "system",
