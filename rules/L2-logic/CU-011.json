{
  "rule_id": "CU-011",
  "name": "巡视记录日期连续性 vs 施工日志",
  "level": "L2-LOGIC",
  "scope": "CROSS_DOC",
  "category": "跨单位日期对照",
  "description": "《巡视记录》（A.9）应覆盖施工日志中有施工活动的日期。施工日志有施工记录但当天无巡视记录，或巡视记录日期无对应施工活动均为矛盾",
  "trigger_when": {
    "doc_type_a": "巡视记录",
    "doc_type_b": "施工日志",
    "require_both": true
  },
  "alignment": {
    "party_a": {
      "role": "supervisor",
      "label": "监理方",
      "doc_type": "巡视记录"
    },
    "party_b": {
      "role": "contractor",
      "label": "施工方",
      "doc_type": "施工日志"
    },
    "join_key": [
      "项目编号",
      "日期"
    ],
    "field_a": "巡视日期",
    "field_b": "施工日期",
    "aggregation": "set_contains"
  },
  "check_expr": {
    "type": "cross_compare",
    "expr": "set(field_b_dates).issubset(set(field_a_dates))",
    "language": "python_eval"
  },
  "error_template": "施工日志有施工活动日期 {field_b} 但当天无巡视记录，或巡视记录日期无对应施工活动",
  "severity_on_violation": "Sanity Check",
  "confirmation_required": true,
  "confirmation_scope": "both_parties_or_admin",
  "remediation": "核查巡视记录是否覆盖施工日志中所有有施工活动的日期",
  "status": "active",
  "source": "system",
  "version": "1.0.0",
