{
  "rule_id": "CU-013",
  "name": "工程试验段：施工 → 记录 → 总结审批",
  "level": "L2-LOGIC",
  "scope": "CROSS_DOC",
  "category": "跨单位日期对照",
  "description": "工程试验段流程：试验段施工日期 ≤ 工艺参数记录日期 ≤ 总结报告编制日期 ≤ 审批日期。总结报告日期早于施工日期，或审批日期早于编制日期均为矛盾。跨单位核心校验为监理审批日期 ≥ 施工方施工日期",
  "trigger_when": {
    "doc_type_a": "试验段总结审批记录",
    "doc_type_b": "试验段施工记录",
    "require_both": true
  },
  "alignment": {
    "party_a": {
      "role": "supervisor",
      "label": "监理方",
      "doc_type": "试验段总结审批记录"
    },
    "party_b": {
      "role": "contractor",
      "label": "施工方",
      "doc_type": "试验段施工记录"
    },
    "join_key": [
      "项目编号",
      "试验段编号"
    ],
    "field_a": "审批日期",
    "field_b": "施工日期",
    "aggregation": "none"
  },
  "check_expr": {
    "type": "cross_compare",
    "expr": "field_a >= field_b",
    "language": "python_eval"
  },
  "error_template": "试验段总结审批日期 {field_a} 早于施工日期 {field_b}，或审批日期早于编制日期，流程倒签",
  "severity_on_violation": "Sanity Check",
  "confirmation_required": true,
  "confirmation_scope": "both_parties_or_admin",
  "remediation": "核查试验段施工、参数记录、总结编制、审批各环节日期顺序",
  "status": "active",
  "source": "system",
  "version": "1.0.0",
