{
  "rule_id": "LG-504",
  "name": "代签需有书面授权",
  "level": "L2-LOGIC",
  "scope": "CROSS_DOC",
  "category": "签字一致性",
  "description": "代签本身不合规，授权代签需有书面授权。矛盾表现：明显代签但无授权。",
  "trigger_when": {
    "doc_type": [
      "*"
    ],
    "field_required": [
      "签字人",
      "签字图像",
      "授权委托书"
    ]
  },
  "check_expr": {
    "type": "cross_compare",
    "expr": "not exists(代签嫌疑) or exists(授权委托书 where 被授权人 == 签字人 and 授权范围包含 当前资料类型)",
    "language": "python_eval"
  },
  "error_template": "签字矛盾：{资料类型} {资料编号} 签字人 {签字人} 疑似代签 {被代签人}，但无书面授权委托书",
  "severity_on_violation": "Fatal",
  "remediation": "核查代签是否经授权，无授权则退回重签",
  "status": "active",
  "source": "system",
