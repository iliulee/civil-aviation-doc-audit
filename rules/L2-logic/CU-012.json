{
  "rule_id": "CU-012",
  "name": "工序/检验批验收：施工自检日期 ≤ 监理验收日期",
  "level": "L1-IRON",
  "scope": "CROSS_DOC",
  "category": "跨单位日期对照",
  "description": "工序/检验批验收流程倒签检测：施工单位自检合格日期 ≤ 监理组织验收日期。监理验收日期早于施工自检日期（先验收后自检），或同日但时间倒置均为流程倒签，属铁律级违规",
  "trigger_when": {
    "doc_type_a": "监理验收记录",
    "doc_type_b": "施工自检记录",
    "require_both": true
  },
  "alignment": {
    "party_a": {
      "role": "supervisor",
      "label": "监理方",
      "doc_type": "监理验收记录"
    },
    "party_b": {
      "role": "contractor",
      "label": "施工方",
      "doc_type": "施工自检记录"
    },
    "join_key": [
      "项目编号",
      "工序名称",
      "检验批编号"
    ],
    "field_a": "监理验收日期",
    "field_b": "施工自检日期",
    "aggregation": "none"
  },
  "check_expr": {
    "type": "cross_compare",
    "expr": "field_a >= field_b",
    "language": "python_eval"
  },
  "error_template": "监理验收日期 {field_a} 早于施工自检日期 {field_b}，流程倒签（先验收后自检）",
  "severity_on_violation": "Fatal",
  "confirmation_required": true,
  "confirmation_scope": "both_parties_or_admin",
  "remediation": "核查施工自检与监理验收的真实先后顺序，确认是否存在流程倒签",
  "status": "active",
  "source": "system",
  "version": "1.0.0",
