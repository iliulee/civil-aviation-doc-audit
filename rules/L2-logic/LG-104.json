{
  "rule_id": "LG-104",
  "name": "监理通知单日期 ≤ 整改回复日期 ≤ 整改复核日期",
  "level": "L2-LOGIC",
  "scope": "CROSS_DOC",
  "category": "时间轴一致性",
  "description": "通知 → 整改 → 复核，闭环。矛盾表现：回复日期早于通知日期，或复核日期早于回复日期。",
  "trigger_when": {
    "doc_type": [
      "监理通知单",
      "整改回复单",
      "整改复核记录"
    ],
    "field_required": [
      "日期",
      "通知单编号"
    ]
  },
  "check_expr": {
    "type": "expression",
    "expr": "监理通知单日期 <= 整改回复日期 and 整改回复日期 <= 整改复核日期",
    "language": "python_eval"
  },
  "error_template": "时间轴矛盾：监理通知单 {通知单编号} 签发日期 {监理通知单日期}，整改回复日期 {整改回复日期}，复核日期 {整改复核日期}，顺序倒置",
  "severity_on_violation": "Sanity Check",
  "remediation": "核查整改流程是否倒签，或日期填错",
