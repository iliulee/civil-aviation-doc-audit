{
  "rule_id": "CU-006",
  "name": "施工进度计划报审：编制日期 → 审查日期",
  "level": "L2-LOGIC",
  "scope": "CROSS_DOC",
  "category": "跨单位日期对照",
  "description": "施工进度计划报审流程：《施工进度计划报审表》（B.22）计划编制日期 ≤ 监理审查日期。计划中各节点的起止日期应在编制日期之后。跨单位核心校验为监理审查日期 ≥ 施工编制日期",
  "trigger_when": {
    "doc_type_a": "施工进度计划报审表",
    "doc_type_b": "施工进度计划报审表",
    "require_both": true
  },
  "alignment": {
    "party_a": {
      "role": "supervisor",
      "label": "监理方",
      "doc_type": "施工进度计划报审表"
    },
    "party_b": {
      "role": "contractor",
      "label": "施工方",
      "doc_type": "施工进度计划报审表"
    },
    "join_key": [
      "项目编号"
    ],
    "field_a": "审查日期",
    "field_b": "编制日期",
    "aggregation": "none"
  },
  "check_expr": {
    "type": "cross_compare",
    "expr": "field_a >= field_b",
    "language": "python_eval"
  },
  "error_template": "施工进度计划审查日期 {field_a} 早于编制日期 {field_b}，或计划节点开始日期早于编制日期，流程倒签",
  "severity_on_violation": "Sanity Check",
  "confirmation_required": true,
  "confirmation_scope": "both_parties_or_admin",
  "remediation": "核查计划编制日期、监理审查日期顺序，及各节点起止日期是否在编制日期之后",
  "status": "active",
