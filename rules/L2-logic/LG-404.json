{
  "rule_id": "LG-404",
  "name": "进度描述一致性",
  "level": "L2-LOGIC",
  "scope": "CROSS_DOC",
  "category": "状态描述一致性",
  "description": "进度计划、实际进度、月报、监理评估应一致。矛盾表现：进度计划说\"完成 80%\"，月报说\"完成 50%\"。",
  "trigger_when": {
    "doc_type": [
      "进度计划",
      "实际进度记录",
      "月报",
      "监理评估报告"
    ],
    "field_required": [
      "完成百分比",
      "统计日期"
    ]
  },
  "check_expr": {
    "type": "cross_compare",
    "expr": "abs(进度计划完成率 - 月报完成率) <= 0.1 and abs(月报完成率 - 监理评估完成率) <= 0.1",
    "language": "python_eval"
  },
  "error_template": "状态矛盾：统计日期 {统计日期} 进度计划完成率 {进度计划完成率}，月报 {月报完成率}，监理评估 {监理评估完成率}，差异超出 ±10%",
  "severity_on_violation": "Sanity Check",
  "remediation": "核查进度数据是否真实，或统计口径不一致",
  "status": "active",
  "source": "system",
  "version": "1.0.0",
