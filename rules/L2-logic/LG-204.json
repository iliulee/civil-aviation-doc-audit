{
  "rule_id": "LG-204",
  "name": "材料报审量 ≥ 实际使用量",
  "level": "L2-LOGIC",
  "scope": "CROSS_DOC",
  "category": "数量累计一致性",
  "description": "进场材料不会比实际使用少。矛盾表现：使用量 > 进场量（材料来源不明）。",
  "trigger_when": {
    "doc_type": ["材料报审表", "材料进场记录", "检验批", "施工记录"],
    "field_required": ["材料名称", "数量"]
  },
  "check_expr": {
    "type": "aggregation",
    "expr": "材料报审量 >= sum(实际使用量)",
    "language": "python_eval"
  },
  "error_template": "数量累计矛盾：材料 {材料名称} 报审量 {材料报审量}，实际使用量 {实际使用量}，使用量大于进场量，材料来源不明",
  "severity_on_violation": "Fatal",
  "remediation": "核查是否有未报审材料进场，或使用量统计错误",
  "status": "active",
