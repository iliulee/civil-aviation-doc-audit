{
  "rule_id": "CU-005",
  "name": "费用索赔报审：事件日期 → 申请日期 → 审核日期",
  "level": "L2-LOGIC",
  "scope": "CROSS_DOC",
  "category": "跨单位日期对照",
  "description": "费用索赔报审流程：索赔事件发生日期 ≤ 《费用索赔报审表》（B.27）申请日期 ≤ 监理审核日期。索赔金额计算依据的日期应在事件发生之后。跨单位核心校验为监理审核日期 ≥ 施工申请日期",
  "trigger_when": {
    "doc_type_a": "费用索赔报审表",
    "doc_type_b": "费用索赔报审表",
    "require_both": true
  },
  "alignment": {
    "party_a": {
      "role": "supervisor",
      "label": "监理方",
      "doc_type": "费用索赔报审表"
    },
    "party_b": {
      "role": "contractor",
      "label": "施工方",
      "doc_type": "费用索赔报审表"
    },
    "join_key": [
      "项目编号"
    ],
    "field_a": "审核日期",
    "field_b": "申请日期",
    "aggregation": "none"
  },
  "check_expr": {
    "type": "cross_compare",
    "expr": "field_a >= field_b",
    "language": "python_eval"
  },
  "error_template": "费用索赔报审审核日期 {field_a} 早于申请日期 {field_b}，或索赔金额依据日期早于事件发生日期，流程倒签",
  "severity_on_violation": "Sanity Check",
  "confirmation_required": true,
  "confirmation_scope": "both_parties_or_admin",
  "remediation": "核查索赔事件日期、申请日期、审核日期顺序，及索赔金额依据日期是否在事件发生之后",
