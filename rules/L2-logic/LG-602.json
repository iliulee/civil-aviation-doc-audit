{
  "rule_id": "LG-602",
  "name": "重大设计变更的连锁响应",
  "level": "L2-LOGIC",
  "scope": "CROSS_DOC",
  "category": "因果一致性",
  "description": "重大设计变更 → 施工方案变更 + 监理细则变更。矛盾表现：设计已变更但方案/细则未更新。",
  "trigger_when": {
    "doc_type": ["设计变更通知单", "施工方案", "监理细则"],
    "field_required": ["变更编号", "方案版本", "细则版本"]
  },
  "check_expr": {
    "type": "cross_compare",
    "expr": "exists(施工方案变更 where 对应变更编号 == 设计变更编号) and exists(监理细则变更 where 对应变更编号 == 设计变更编号)",
    "language": "python_eval"
  },
  "error_template": "因果矛盾：设计变更 {设计变更编号} 已下发，但施工方案或监理细则未相应更新",
  "severity_on_violation": "Sanity Check",
  "remediation": "核查施工方案和监理细则是否同步更新",
  "status": "active",
  "source": "system",
