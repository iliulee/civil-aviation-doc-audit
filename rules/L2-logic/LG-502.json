{
  "rule_id": "LG-502",
  "name": "签字必须伴随日期",
  "level": "L2-LOGIC",
  "scope": "SINGLE_DOC",
  "category": "签字一致性",
  "description": "任何签字都应伴随日期。矛盾表现：签字但无日期。",
  "trigger_when": {
    "doc_type": [
      "*"
    ],
    "field_required": [
      "签字人",
      "签字日期"
    ]
  },
  "check_expr": {
    "type": "expression",
    "expr": "all(签字日期 is not None and 签字日期 != '' for 签字 in 所有签字)",
    "language": "python_eval"
  },
  "error_template": "签字矛盾：{资料类型} {资料编号} 中签字人 {签字人} 无签字日期",
  "severity_on_violation": "Sanity Check",
  "remediation": "核查签字日期是否漏填，必要时退回补签",
  "status": "active",
  "source": "system",
