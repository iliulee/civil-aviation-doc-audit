{
  "rule_id": "LG-205",
  "name": "试验检测批次数量 ≥ 检验批数量",
  "level": "L2-LOGIC",
  "scope": "CROSS_DOC",
  "category": "数量累计一致性",
  "description": "每个检验批都应有对应的检测报告。矛盾表现：10个检验批只有5份检测报告。",
  "trigger_when": {
    "doc_type": [
      "检验批质量验收记录",
      "试验检测报告"
    ],
    "field_required": [
      "检验批编号",
      "报告编号"
    ]
  },
  "check_expr": {
    "type": "aggregation",
    "expr": "count(试验检测报告) >= count(检验批)",
    "language": "python_eval"
  },
  "error_template": "数量累计矛盾：检验批 {检验批数量} 个，但试验检测报告仅 {报告数量} 份，存在未检测的检验批",
  "severity_on_violation": "Fatal",
  "remediation": "核查是否漏做检测，或检测报告缺失",
  "status": "active",
  "source": "system",
