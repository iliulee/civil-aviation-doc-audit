{
  "rule_id": "LG-302",
  "name": "检验批签认人员 = 实际在岗人员",
  "level": "L2-LOGIC",
  "scope": "CROSS_DOC",
  "category": "人员一致性",
  "description": "签字人应在项目部组织架构内。矛盾表现：签字人不在岗或无此人。",
  "trigger_when": {
    "doc_type": ["检验批质量验收记录", "项目部组织架构", "考勤表"],
    "field_required": ["签字人", "岗位"]
  },
  "check_expr": {
    "type": "cross_compare",
    "expr": "all(签字人 in 项目部组织架构人员 for 签字人 in 检验批签字人) and all(签字人 in 当日考勤人员 for 签字人 in 检验批签字人)",
    "language": "python_eval"
  },
  "error_template": "人员矛盾：检验批 {检验批编号} 签字人 {签字人} 不在项目部组织架构或当日考勤表中",
  "severity_on_violation": "Sanity Check",
  "remediation": "核查签字人是否冒名或考勤漏记",
  "status": "active",
  "source": "system",
