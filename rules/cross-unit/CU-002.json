{
  "rule_id": "CU-002",
  "name": "开工令日期 ≥ 开工报审表日期",
  "level": "L2-LOGIC",
  "scope": "CROSS_UNIT",
  "category": "跨单位日期对照",
  "description": "开工令日期应不早于开工报审表日期，流程顺序：报审→批复→开工令。施工单位《工程开工报审表》（B.10）申请开工日期 ≤ 监理签发《开工令》（A.6）日期",
  "trigger_when": {
    "doc_type_a": "开工令",
    "doc_type_b": "开工报审表",
    "require_both": true
  },
  "alignment": {
    "party_a": {
      "role": "supervisor",
      "label": "监理方",
      "doc_type": "开工令"
    },
    "party_b": {
      "role": "contractor",
      "label": "施工方",
      "doc_type": "开工报审表"
    },
    "join_key": ["项目编号"],
    "field_a": "开工令日期",
    "field_b": "报审表日期",
    "aggregation": "none"
  },
  "check_expr": {
    "type": "cross_compare",
    "expr": "field_a >= field_b",
    "language": "python_eval"
  },
  "error_template": "开工令日期 {field_a} 早于开工报审表日期 {field_b}，流程倒签（先批后报）",
  "severity_on_violation": "Sanity Check",
  "confirmation_required": true,
  "confirmation_scope": "both_parties_or_admin",
  "remediation": "核查日期是否填错，或流程是否倒签",
  "status": "active",
  "source": "system",
  "version": "1.0.0",
