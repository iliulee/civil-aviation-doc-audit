{
  "rule_id": "CU-016",
  "name": "平行检测报告 vs 施工检测报告日期比对",
  "level": "L2-LOGIC",
  "scope": "CROSS_UNIT",
  "category": "跨单位日期对照",
  "description": "平行检测取样日期应与施工检测取样日期相近（同批次或同期）。平行检测报告日期 ≥ 施工检测报告日期（监理复核在后）。平行检测报告日期早于施工检测报告日期，或取样日期相差过大（非同批次）均为矛盾",
  "trigger_when": {
    "doc_type_a": "平行检测报告",
    "doc_type_b": "施工检测报告",
    "require_both": true
  },
  "alignment": {
    "party_a": {
      "role": "supervisor",
      "label": "监理方",
      "doc_type": "平行检测报告"
    },
    "party_b": {
      "role": "contractor",
      "label": "施工方",
      "doc_type": "施工检测报告"
    },
    "join_key": ["项目编号", "检验批编号", "批次"],
    "field_a": "平行检测报告日期",
    "field_b": "施工检测报告日期",
    "aggregation": "none"
  },
  "check_expr": {
    "type": "cross_compare",
    "expr": "field_a >= field_b",
    "language": "python_eval"
  },
  "error_template": "平行检测报告日期 {field_a} 早于施工检测报告日期 {field_b}，或取样日期相差过大（非同批次）",
  "severity_on_violation": "Sanity Check",
  "confirmation_required": true,
  "confirmation_scope": "both_parties_or_admin",
  "remediation": "核查平行检测与施工检测的取样日期是否同批次，及报告日期顺序是否正确（监理复核在后）",
  "status": "active",
