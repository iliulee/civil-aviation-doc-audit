{
  "rule_id": "CU-007",
  "name": "工程款支付报审：申请日期 → 审核日期 → 签发日期",
  "level": "L2-LOGIC",
  "scope": "CROSS_UNIT",
  "category": "跨单位日期对照",
  "description": "工程款支付报审流程：《工程款支付报审表》（B.23）申请日期 ≤ 监理审核日期 ≤ 签发日期。支付周期内的工程量应与同期检验批/验收记录对应。跨单位核心校验为监理签发日期 ≥ 施工申请日期",
  "trigger_when": {
    "doc_type_a": "工程款支付报审表",
    "doc_type_b": "工程款支付报审表",
    "require_both": true
  },
  "alignment": {
    "party_a": {
      "role": "supervisor",
      "label": "监理方",
      "doc_type": "工程款支付报审表"
    },
    "party_b": {
      "role": "contractor",
      "label": "施工方",
      "doc_type": "工程款支付报审表"
    },
    "join_key": ["项目编号", "支付周期"],
    "field_a": "签发日期",
    "field_b": "申请日期",
    "aggregation": "none"
  },
  "check_expr": {
    "type": "cross_compare",
    "expr": "field_a >= field_b",
    "language": "python_eval"
  },
  "error_template": "工程款支付报审签发日期 {field_a} 早于申请日期 {field_b}，或支付工程量无对应验收记录",
  "severity_on_violation": "Sanity Check",
  "confirmation_required": true,
  "confirmation_scope": "both_parties_or_admin",
  "remediation": "核查申请日期、审核日期、签发日期顺序，及支付周期工程量是否与同期检验批对应",
