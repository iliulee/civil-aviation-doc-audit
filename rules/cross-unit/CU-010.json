{
  "rule_id": "CU-010",
  "name": "旁站通知提前量：施工日期 - 通知日期 ≥ 12小时",
  "level": "L2-LOGIC",
  "scope": "CROSS_UNIT",
  "category": "跨单位日期对照",
  "description": "施工方书面通知监理的日期应不晚于施工日期，且提前量 ≥ 12 小时。通知日期与施工日期同日（未提前12小时），或通知日期晚于施工日期（先施工后通知）均为矛盾",
  "trigger_when": {
    "doc_type_a": "旁站记录",
    "doc_type_b": "旁站通知",
    "require_both": true
  },
  "alignment": {
    "party_a": {
      "role": "supervisor",
      "label": "监理方",
      "doc_type": "旁站记录"
    },
    "party_b": {
      "role": "contractor",
      "label": "施工方",
      "doc_type": "旁站通知"
    },
    "join_key": ["项目编号", "工序名称"],
    "field_a": "施工日期",
    "field_b": "通知日期",
    "aggregation": "none"
  },
  "check_expr": {
    "type": "cross_compare",
    "expr": "hours_between(field_a, field_b) >= 12",
    "language": "python_eval"
  },
  "error_template": "旁站通知提前量不足：施工日期 {field_a}，通知日期 {field_b}，提前量不足 12 小时或通知晚于施工",
  "severity_on_violation": "Sanity Check",
  "confirmation_required": true,
  "confirmation_scope": "both_parties_or_admin",
  "remediation": "核查施工方书面通知日期与施工日期的提前量是否达到 12 小时",
  "status": "active",
  "source": "system",
  "version": "1.0.0",
