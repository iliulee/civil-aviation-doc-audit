{
  "rule_id": "LG-702",
  "name": "规范编号格式统一",
  "level": "L3-BUSINESS",
  "scope": "CROSS_DOC",
  "category": "规范引用一致性",
  "description": "同一项目应使用统一的编号格式，如 MH/T 5078.1-2024 应统一（不要混用 MH/T5078.1-2024）。",
  "trigger_when": {
    "doc_type": ["检验批质量验收记录", "施工记录", "检测报告"],
    "field_required": ["规范编号"]
  },
  "check_expr": {
    "type": "cross_compare",
    "expr": "len(set(规范编号标准化格式 for 规范编号 in 所有资料规范编号)) == 1",
    "language": "python_eval"
  },
  "error_template": "规范引用矛盾：规范 {规范名称} 编号格式不统一，{资料A} 写作 {格式A}，{资料B} 写作 {格式B}",
  "severity_on_violation": "Best Practice",
  "remediation": "统一规范编号书写格式，按规范标准写法",
